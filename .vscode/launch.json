{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: debug API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Tests: debug current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q", "-p", "no:cacheprovider"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
